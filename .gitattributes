# Use the union merge driver for CHANGELOG.md so that parallel PRs adding
# entries under `## [Unreleased]` don't conflict on every merge. Git takes
# lines from both sides of any conflict region and concatenates them. The
# resulting order may be jumbled — clean up under-headers in a follow-up
# tidy commit if needed.
CHANGELOG.md merge=union

# Migration files are hashed byte-for-byte; keep LF on every platform.
src/db/migrations/** text eol=lf

scripts/*.sh text eol=lf
scripts/db/*.sh text eol=lf
